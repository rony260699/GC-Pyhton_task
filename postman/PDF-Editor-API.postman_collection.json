      {"key": "position", "value": "center", "type": "text"}, {"key": "opacity", "value": "0.25", "type": "text"}, {"key": "color", "value": "#FF0000", "type": "text"}
    ]}, "url": "{{baseUrl}}/editor/pdf/watermark"}}
